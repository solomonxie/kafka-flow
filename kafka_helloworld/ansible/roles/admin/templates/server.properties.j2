# KRaft node role: this single node is both broker and controller
process.roles=broker,controller

# Unique ID of this node (only one node, so it's fixed)
node.id=1

# Controller quorum: self-bootstrapped, single-node cluster
controller.quorum.bootstrap.servers=localhost:9093
controller.listener.names=CONTROLLER

# Network: what to bind vs what clients should connect to
listeners=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
advertised.listeners=PLAINTEXT://{{ ansible_host }}:9092

# Storage: where log segments are written
log.dirs={{ kafka_data_dir }}
